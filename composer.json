{
    "name": "misaf/vendra-reseller",
    "description": "Reseller domain and self-service panel for the Vendra platform",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "reseller"
    ],
    "homepage": "https://github.com/misaf/vendra-reseller",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.6.8",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "misaf/laravel-email-verification-emailable": "^1.0",
        "misaf/vendra-localization": "self.version",
        "misaf/vendra-store": "self.version",
        "misaf/vendra-subscription": "self.version",
        "misaf/vendra-support": "self.version",
        "misaf/vendra-tenant": "self.version",
        "misaf/vendra-transaction": "self.version",
        "spatie/laravel-multitenancy": "^4.1.3",
        "spatie/laravel-package-tools": "^1.93.1",
        "spatie/laravel-sluggable": "^4.0.2"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraReseller\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraReseller\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraReseller\\Providers\\ResellerServiceProvider",
                "Misaf\\VendraReseller\\Providers\\ResellerPanelServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-reseller/issues",
        "source": "https://github.com/misaf/vendra-reseller"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
